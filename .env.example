# Copie ce fichier en .env pour configurer le serveur (tout est optionnel en local).

# --- Serveur ---
PORT=3000
# 127.0.0.1 = accessible seulement depuis ton ordinateur ; 0.0.0.0 pour un serveur en ligne (derrière HTTPS)
HOST=127.0.0.1
# Noms de domaine acceptés, séparés par des virgules (ajoute ton domaine si tu mets le site en ligne)
ALLOWED_HOSTS=localhost,127.0.0.1
# true dès que le site est servi en HTTPS
COOKIE_SECURE=false
# false pour empêcher de nouvelles inscriptions
ALLOW_SIGNUP=true
# Clé de chiffrement des mots de passe Gmail (64 caractères hex). Générée dans data/secret.key si absente.
# Pour en créer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRET_KEY=

# Les identifiants Gmail se règlent désormais dans l'appli (⚙️ Paramètres), propres à chaque compte.
